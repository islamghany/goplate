# goplate configuration. Copy to .env for local development:
#   cp .env.example .env
# The binary only reads real environment variables; `make run` and
# docker compose load this file for you. Every variable, its type and its
# default is defined in internal/config (ADR-0016).
#
# Keep comments on their own lines: `make` would keep the spaces before an
# inline comment as part of the value.

# --- App -------------------------------------------------------------------
APP_NAME=goplate
# development | test | production
APP_ENV=development

# --- Logging ---------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug
# json (production) | text (humans)
LOG_FORMAT=text

# --- Public HTTP server ----------------------------------------------------
HTTP_ADDR=:8080
# Your frontend origins (comma-separated): the CORS + CSRF allow-list.
HTTP_TRUSTED_ORIGINS=http://localhost:3000
# CIDRs of your load balancer / ingress, allowed to set X-Forwarded-For.
HTTP_TRUSTED_PROXIES=
# Serve /docs and /openapi.yaml.
HTTP_DOCS_ENABLED=true
#HTTP_READ_HEADER_TIMEOUT=5s
#HTTP_READ_TIMEOUT=15s
#HTTP_WRITE_TIMEOUT=30s
#HTTP_IDLE_TIMEOUT=120s
#HTTP_MAX_BODY_BYTES=1048576

# --- Internal admin server: metrics, readiness details, pprof -------------
# Never expose this port publicly.
ADMIN_ADDR=:9090
ADMIN_PPROF=true

# --- Shutdown --------------------------------------------------------------
# Use 5s or more behind a load balancer.
SHUTDOWN_DRAIN_DELAY=0s
SHUTDOWN_TIMEOUT=20s

# --- Postgres --------------------------------------------------------------
POSTGRES_URL=postgres://goplate:goplate@localhost:5432/goplate?sslmode=disable
# Prefer `make migrate`; never enable with more than one replica.
POSTGRES_MIGRATE_ON_START=false
#POSTGRES_MAX_CONNS=10
#POSTGRES_MIN_CONNS=2

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# redis | memory
CACHE_DRIVER=redis
# redis | memory
RATELIMIT_DRIVER=redis

# --- Rate limiting ---------------------------------------------------------
RATELIMIT_RATE=100
RATELIMIT_PERIOD=1m
RATELIMIT_BURST=20
# Login attempts per IP per minute, and per email per hour.
RATELIMIT_LOGIN_IP_RATE=5
RATELIMIT_LOGIN_EMAIL_RATE=10
RATELIMIT_LOGIN_FAIL_CLOSED=true

# --- Auth ------------------------------------------------------------------
# HS256 | EdDSA
AUTH_JWT_ALGORITHM=HS256
# HS256 secret, at least 32 bytes. Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=change-me-change-me-change-me-change-me-0123456789
# EdDSA only: base64 Ed25519 seed. Generate one with: openssl rand -base64 32
#AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_ISSUER=goplate
AUTH_JWT_AUDIENCE=goplate-api
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_BEARER_ENABLED=true
AUTH_COOKIE_ENABLED=true
AUTH_COOKIE_DOMAIN=
AUTH_DENYLIST_ENABLED=false

# --- Background jobs -------------------------------------------------------
# false = API-only process: inserts jobs but does not work them.
JOBS_WORKER_ENABLED=true
JOBS_MAX_WORKERS=10

# --- Note module -----------------------------------------------------------
NOTE_CACHE_TTL=5m

# --- OpenTelemetry (standard OTEL_* variables) -----------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# none disables tracing
OTEL_TRACES_EXPORTER=otlp
#OTEL_TRACES_SAMPLER=parentbased_traceidratio
#OTEL_TRACES_SAMPLER_ARG=0.1

# --- Admin command (make seed) ---------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin-password-change-me
